# AshityShop Backend - example env
# Database
MONGODB_URI=mongodb://localhost:27017/ashityshop

# App
PORT=
NODE_ENV=
CLIENT_URL=

# JWT (use long random secrets, >=32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (if used)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# Uploads
MAX_FILE_SIZE=

# ==========================================
# SMS GATEWAY CONFIGURATION (Android SMS Gateway)
# ==========================================
SMS_ENABLED=
SMS_GATEWAY_MODE=
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TIMEOUT=
